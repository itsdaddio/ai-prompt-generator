# Copy this file to .env.local for local development.
# NEVER commit an actual .env.local or real secrets — .gitignore already excludes it.

# Required for live Claude generation. Without this, the app automatically
# falls back to the built-in template engine (no external API calls).
# Get a key from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Free-tier daily generation cap, enforced server-side per client IP.
# Optional — defaults to 10 if unset.
FREE_DAILY_GENERATION_LIMIT=10

# Placeholder for a future paid tier's daily cap. Not currently enforced
# anywhere (no billing/auth is wired up yet) — see lib/entitlements.ts.
PRO_DAILY_GENERATION_LIMIT=500

# The canonical production URL, used for metadata/canonical/OG tags and the
# sitemap. Set this to the real deployed domain in Vercel's project settings.
NEXT_PUBLIC_SITE_URL=https://prompts.itsdad.io
